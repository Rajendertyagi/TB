<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="using:TB.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <helpers:BoolToActiveBgConverter x:Key="BoolToActiveBgConverter"/>

    <!-- Fallback size/length resources (overridden by ThemeService from theme.json) -->
    <x:Double x:Key="navHeightLength">34</x:Double>
    <x:Double x:Key="tabbarHeightLength">34</x:Double>
    <x:Double x:Key="tabHeightLength">28</x:Double>
    <x:Double x:Key="urlbarHeightLength">28</x:Double>
    <CornerRadius x:Key="radiusSmLength">6</CornerRadius>
    <CornerRadius x:Key="radiusMdLength">8</CornerRadius>
    <CornerRadius x:Key="radiusLgLength">20</CornerRadius>
    <x:Double x:Key="tabInterTabGapLength">2</x:Double>
    <x:Double x:Key="tabMinWidthLength">32</x:Double>
    <x:Double x:Key="tabMaxWidthLength">180</x:Double>

    <!-- TB-style context menu presenter (used by ShowTabContextMenu) -->
    <Style x:Key="TbMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource bgAppBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource borderCrispBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource radiusMdLength}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="MinWidth" Value="160"/>
    </Style>

    <!-- TB-style context menu item -->
    <Style x:Key="TbMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/OpenSans-Regular.ttf#Open Sans"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{ThemeResource textMainBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinWidth" Value="160"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Open Sans font for all UI chrome elements -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/OpenSans-Regular.ttf#Open Sans"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/OpenSans-Regular.ttf#Open Sans"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="ms-appx:///Assets/Fonts/OpenSans-Regular.ttf#Open Sans"/>
    </Style>

</ResourceDictionary>
