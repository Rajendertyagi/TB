<Window
    x:Class="TB.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TB.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- FIX: Removed FontFamily. Grid is a Panel, not a Control. 
         The implicit styles in your ResourceDictionary will handle the font globally. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource bgAppBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="ChromeContainer" 
              Grid.Row="0" 
              Background="{ThemeResource bgAppBrush}"
              PointerEntered="ChromeContainer_PointerEntered"
              PointerExited="ChromeContainer_PointerExited">

            <Grid.RowDefinitions>
                <RowDefinition Height="{ThemeResource tabbarHeightLength}"/>
                <RowDefinition Height="{ThemeResource navHeightLength}"/>
            </Grid.RowDefinitions>

            <!-- Modular Controls -->
            <controls:TabStrip x:Name="TabStrip" Grid.Row="0" DataContext="{Binding}" />
            <controls:NavigationBar x:Name="NavBar" Grid.Row="1" DataContext="{Binding}" />
        </Grid>

        <Grid x:Name="ContentGrid" Grid.Row="1" Background="{ThemeResource bgAppBrush}"/>

    </Grid>
</Window>

    