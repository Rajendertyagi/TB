<Window
    x:Class="TB.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid x:Name="RootGrid" Background="#09090b">
		<Grid.RowDefinitions>
			<RowDefinition Height="68"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<Grid x:Name="AppTitleBar" Grid.Row="0" Height="1" Width="1" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" />

		<WebView2 x:Name="ShellWebView" Grid.Row="0" />
		<Grid x:Name="ContentGrid" Grid.Row="1" Background="#09090b"/>
	</Grid>
</Window>
