<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ThemeDictionaries are intentionally empty.
        All colors live in wwwroot/themes/<name>.json (single source of truth).
        ThemeService.ApplyXamlResources() mutates brush singletons in App.xaml
        from the active JSON theme before window.Activate().
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark"/>
        <ResourceDictionary x:Key="Light"/>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
