<UserControl
    x:Class="TB.Controls.NavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="NavBarGrid" Padding="4,4,4,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Back, Forward, Reload, Home — 24×24, 4px spacing -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding BackCommand}">
                <Path Data="{StaticResource IconBackData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ForwardCommand}">
                <Path Data="{StaticResource IconForwardData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ReloadCommand}">
                <Path Data="{StaticResource IconRefreshData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding HomeCommand}">
                <Path Data="{StaticResource IconHomeData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
        </StackPanel>

        <!-- Center: Omnibar — 4px radius, 1px visible border, 28px height -->
        <Border x:Name="UrlBarBorder"
                Grid.Column="1"
                Style="{StaticResource UrlBarBorderStyle}"
                Margin="8,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="SecurityIcon"
                      Grid.Column="0"
                      Data="{StaticResource IconLockData}"
                      Style="{StaticResource SmallIconPathStyle}"
                      Margin="10,0,6,0"
                      VerticalAlignment="Center"
                      Opacity="0.5"/>

                <TextBox x:Name="UrlInput"
                         Grid.Column="1"
                         Text="{Binding UrlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource UrlBarInputStyle}"
                         PlaceholderText="Search or enter address"
                         GotFocus="OnUrlInputGotFocus"
                         LostFocus="OnUrlInputLostFocus"
                         KeyDown="OnUrlInputKeyDown"/>
            </Grid>
        </Border>

        <!-- Right: Downloads, Settings, Flags, Menu — 4px spacing, 4px end margin -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding DownloadsCommand}">
                <Path Data="{StaticResource IconDownloadData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding SettingsCommand}">
                <Path Data="{StaticResource IconSettingsGearData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" Command="{Binding FlagsCommand}">
                <Path Data="{StaticResource IconFlagData}" Style="{StaticResource NavIconPathStyle}"/>
            </Button>
            <Button Style="{StaticResource NavButtonStyle}" VerticalAlignment="Center">
                <Path Data="{StaticResource IconMenuData}" Style="{StaticResource NavIconPathStyle}"/>

                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight" MenuFlyoutPresenterStyle="{StaticResource TbMenuFlyoutPresenterStyle}">
                        <MenuFlyoutItem Text="Downloads" Command="{Binding DownloadsCommand}" Style="{StaticResource TbMenuFlyoutItemStyle}"/>
                        <MenuFlyoutItem Text="History"   Command="{Binding HistoryCommand}"   Style="{StaticResource TbMenuFlyoutItemStyle}"/>
                        <MenuFlyoutItem Text="Settings"  Command="{Binding SettingsCommand}"  Style="{StaticResource TbMenuFlyoutItemStyle}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Flags"     Command="{Binding FlagsCommand}"     Style="{StaticResource TbMenuFlyoutItemStyle}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>