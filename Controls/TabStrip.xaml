<UserControl
 x:Class="TB.Controls.TabStrip"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d">

    <Grid x:Name="TabStripGrid" Padding="8,2,0,0" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <!--
                Col 0: Tab content area.
                All tabs + new-tab button live here.
                Width is driven by RecalculateTabWidths(); never bleeds into window controls.
            -->
            <ColumnDefinition Width="*"/>
            <!--
                Col 1: Reserved zone.
                Width = logical(AppWindow.TitleBar.RightInset) + TabStripDragRailWidth.
                Set dynamically from MainWindow via TabStrip.SetReservedRightWidth().
                Tabs are structurally blocked from rendering here.
            -->
            <ColumnDefinition x:Name="ReservedRightColumn" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- 1px separator spans BOTH columns so it draws full window width -->
        <Rectangle Grid.ColumnSpan="2"
                   Fill="{ThemeResource borderCrispBrush}"
                   Height="1"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Stretch"/>

        <!-- Tab content is strictly clipped to col 0 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">

            <ItemsRepeater x:Name="TabRepeater" ItemsSource="{Binding Tabs}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="2"/>
                </ItemsRepeater.Layout>

                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <!--
                            Phase 4: Opacity bound to TabOpacity (0.40 / 0.85 / 1.0).
                            ScalarTransition gives the smooth 120ms fade between states.
                        -->
                        <Button Style="{StaticResource TabItemButtonStyle}"
                                Background="{Binding TabBackground}"
                                BorderBrush="{Binding TabBorderBrush}"
                                Opacity="{Binding TabOpacity}"
                                Command="{Binding SwitchCommand}">
                            <Button.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.12"/>
                            </Button.OpacityTransition>

                            <!--
                                Phase 3: Three-layer stack inside a fixed-height Grid.
                                - Layer 0 (left):  Favicon 16×16 — hidden when squashed+hovered
                                - Layer 1 (center): Title text — hidden when IsSquashed
                                - Layer 2 (left):  Close btn 24×24 — overlays favicon slot when hovered;
                                                   sits on the right at full width
                            -->
                            <Grid Height="28" Padding="0">
                                <Grid.ColumnDefinitions>
                                    <!-- Favicon / close slot: fixed 24px -->
                                    <ColumnDefinition Width="24"/>
                                    <!-- Title: takes remaining space -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Right close button slot (full-width only): fixed 24px -->
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: Favicon -->
                                <Image Grid.Column="0"
                                       Width="16" Height="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Source="{Binding Favicon}"
                                       Stretch="Uniform"
                                       Visibility="{Binding IsFaviconVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Col 1: Title — hidden when Squashed / Overflow -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Style="{StaticResource TabItemHeaderStyle}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"
                                           Visibility="{Binding IsTitleVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!--
                                    Phase 3: Close button.
                                    When squashed+hovered: spans Col 0 (overlays favicon slot → centered).
                                    When NOT squashed: sits in Col 2 (right edge, standard position).
                                    ColumnSpan is driven by IsSquashed binding via a converter
                                    but WinUI can't bind ColumnSpan directly; instead we put TWO
                                    close buttons — one for each layout mode — and toggle visibility.
                                -->

                                <!-- Close button (squashed mode): centered in col 0 over favicon -->
                                <!-- Visible only when squashed AND (hovered OR active): gated by IsCloseButtonVisible -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource TabCloseButtonStyle}"
                                        Command="{Binding CloseCommand}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsCloseSquashedVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.10"/>
                                    </Button.OpacityTransition>
                                    <Path Data="{StaticResource IconTabCloseData}"
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          Fill="Transparent"
                                          Stroke="{ThemeResource textMutedBrush}"
                                          StrokeThickness="1.5"/>
                                </Button>

                                <!-- Close button (normal mode): right edge in col 2 -->
                                <!-- Hidden when squashed (squashed mode handles it via col 0) -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource TabCloseButtonStyle}"
                                        Command="{Binding CloseCommand}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsCloseNormalVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.10"/>
                                    </Button.OpacityTransition>
                                    <Path Data="{StaticResource IconTabCloseData}"
                                          Stretch="Uniform"
                                          Width="10" Height="10"
                                          Fill="Transparent"
                                          Stroke="{ThemeResource textMutedBrush}"
                                          StrokeThickness="1.5"/>
                                </Button>

                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Button Width="24" Height="24"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource NewTabButtonStyle}"
                    Command="{Binding NewTabCommand}">
                <Path Data="{StaticResource IconAddTabData}" Style="{StaticResource NavIconPathStyle}" Width="12" Height="12"/>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>